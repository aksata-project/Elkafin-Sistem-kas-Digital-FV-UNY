<!DOCTYPE html>
<html lang="id" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Elka Financial - Kas Angkatan</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.23/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0A0A0A;
        }

        .loading-spinner {
            border-top-color: #c5cd29;
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #111;
        }

        ::-webkit-scrollbar-thumb {
            background: #333;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #444;
        }

        .tech-bg {
            background-image:
                linear-gradient(rgba(243, 202, 32, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(243, 202, 32, 0.05) 1px, transparent 1px);
            background-size: 30px 30px;
        }

        .glass-card {
            background: rgba(18, 18, 18, 0.6);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid #222;
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .pagination-btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

        .btn-primary {
            background-color: #F3CA20;
            color: #0A0A0A;
            transition: background-color 0.3s ease;
        }

        .btn-primary:hover {
            background-color: #FFDE59;
        }

        .btn-secondary {
            border: 1px solid #444;
            color: #ccc;
            transition: color 0.3s, background-color 0.3s, border-color 0.3s;
        }

        .btn-secondary:hover {
            background-color: #F3CA20;
            border-color: #F3CA20;
            color: #0A0A0A;
        }

        /* Toast Notification */
        #toast-container {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            pointer-events: none;
        }
        .toast {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.85rem 1.25rem;
            border-radius: 0.75rem;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255,255,255,0.08);
            box-shadow: 0 8px 32px rgba(0,0,0,0.5);
            font-size: 0.9rem;
            font-weight: 600;
            pointer-events: all;
            animation: toast-in 0.3s ease forwards;
            max-width: 340px;
        }
        .toast.success { background: rgba(18,18,18,0.92); color: #fde047; border-color: rgba(243,202,32,0.25); }
        .toast.error   { background: rgba(18,18,18,0.92); color: #f87171; border-color: rgba(248,113,113,0.25); }
        .toast.fade-out { animation: toast-out 0.4s ease forwards; }
        @keyframes toast-in  { from { opacity:0; transform: translateY(12px); } to { opacity:1; transform: translateY(0); } }
        @keyframes toast-out { from { opacity:1; transform: translateY(0); } to { opacity:0; transform: translateY(12px); } }

        /* Search input */
        .search-wrapper { position: relative; }
        .search-wrapper svg { position:absolute; left:0.75rem; top:50%; transform:translateY(-50%); pointer-events:none; }
        .search-input { padding-left: 2.25rem !important; }

        /* Stat badge */
        .stat-delta { font-size:0.7rem; padding: 0.15rem 0.4rem; border-radius: 99px; font-weight:700; }

        /* Chart container */
        .chart-container { position: relative; width: 100%; }
    </style>
</head>

<body class="text-gray-300">

    <div id="loading-screen" class="fixed inset-0 bg-black z-50 flex flex-col items-center justify-center">
        <div class="loading-spinner animate-spin rounded-full h-16 w-16 border-4 border-gray-800"></div>
        <p class="mt-4 text-lg font-semibold text-gray-500">Memuat Elka Financial...</p>
    </div>

    <div id="login-screen" class="hidden min-h-screen flex items-center justify-center tech-bg p-4">
        <div class="max-w-md w-full glass-card p-8 rounded-2xl shadow-2xl shadow-black/50">
            <h2 class="text-4xl font-black text-center text-white mb-2 tracking-widest">ELKA <span
                    class="text-yellow-400">FINANCIAL</span></h2>
            <p class="text-center text-gray-400 mb-8">Sistem Kas Angkatan Teknik Elektronika</p>
            <button id="google-login-btn"
                class="w-full btn-secondary text-white py-3 rounded-lg flex items-center justify-center font-semibold">
                <svg class="w-5 h-5 mr-3" viewBox="0 0 48 48">
                    <path fill="#4285F4"
                        d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l8.35 6.48C12.73 13.72 17.97 9.5 24 9.5z">
                    </path>
                    <path fill="#34A853"
                        d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z">
                    </path>
                    <path fill="#FBBC05"
                        d="M10.91 28.19c-.24-.72-.38-1.48-.38-2.28s.14-1.56.38-2.28l-8.35-6.48C.73 19.62 0 21.76 0 24c0 2.24.73 4.38 1.99 6.19l8.92-6.48z">
                    </path>
                    <path fill="#EA4335"
                        d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.03 0-11.27-4.22-13.09-9.98l-8.35 6.48C6.51 42.62 14.62 48 24 48z">
                    </path>
                    <path fill="none" d="M0 0h48v48H0z"></path>
                </svg>
                Masuk dengan Google
            </button>
            <p id="auth-error" class="text-yellow-600 text-sm mt-3 text-center"></p>
        </div>
    </div>

    <div id="app" class="hidden">
        <div class="md:flex min-h-screen">
            <div id="sidebar"
                class="w-full md:w-64 bg-black/80 backdrop-filter backdrop-blur-lg border-r border-gray-800 p-4 space-y-2 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out fixed md:relative h-full z-20 flex flex-col">
                <div>
                    <div class="flex items-center justify-between pb-4">
                        <h1 class="text-2xl font-black text-white tracking-widest">ELKA<span
                                class="text-yellow-400">FIN</span></h1>
                        <button id="close-sidebar-btn" class="md:hidden text-gray-400">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                    <div id="user-profile" class="pt-4 border-t border-gray-800"></div>
                    <nav id="main-nav" class="space-y-1 pt-4"></nav>
                </div>
                <div class="mt-auto pt-4 border-t border-gray-800">
                    <button id="logout-btn"
                        class="w-full text-left flex items-center px-4 py-2.5 rounded-lg text-gray-400 hover:bg-yellow-400/10 hover:text-yellow-300 transition-colors">
                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                            </path>
                        </svg>
                        Keluar
                    </button>
                </div>
            </div>

            <div class="flex-1 md:ml-64 p-4 md:p-8 tech-bg">
                <header class="flex justify-between items-center mb-6">
                    <button id="open-sidebar-btn" class="md:hidden p-2 rounded-md bg-gray-900 text-gray-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                    <div class="flex-1"></div>
                    <div id="date-time-display" class="text-right text-gray-500">
                        <p id="current-time" class="font-bold text-lg text-white"></p>
                        <p id="current-date" class="text-sm"></p>
                    </div>
                </header>

                <div id="announcement-banner" class="hidden mb-6"></div>

                <div id="views-container">
                    <div id="view-angkatan" class="view">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                            <div class="glass-card p-6 rounded-xl">
                                <h3 class="font-semibold text-gray-400 mb-2 tracking-wider text-sm">TOTAL KAS TEORI C
                                </h3>
                                <p id="total-kas-c" class="text-3xl font-bold text-yellow-400">Rp 0</p>
                            </div>
                            <div class="glass-card p-6 rounded-xl">
                                <h3 class="font-semibold text-gray-400 mb-2 tracking-wider text-sm">TOTAL KAS TEORI D
                                </h3>
                                <p id="total-kas-d" class="text-3xl font-bold text-yellow-400">Rp 0</p>
                            </div>
                            <div class="glass-card p-6 rounded-xl">
                                <h3 class="font-semibold text-gray-400 mb-2 tracking-wider text-sm">TOTAL KAS ANGKATAN
                                </h3>
                                <p id="total-kas-angkatan" class="text-3xl font-bold text-white">Rp 0</p>
                            </div>
                        </div>
                        <div id="my-payment-status-container" class="glass-card p-6 rounded-xl mb-8"></div>
                        <div class="flex flex-wrap justify-between items-center mb-6 gap-4">
                            <h2 class="text-4xl font-bold text-white">Laporan Pemasukan</h2>
                            <div class="flex items-center gap-2">
                                <div id="week-management-actions" class="hidden items-center gap-2">
                                    <button id="remove-week-btn" class="btn-secondary text-xs px-3 py-1 rounded-md">-
                                        Minggu</button>
                                    <button id="add-week-btn" class="btn-secondary text-xs px-3 py-1 rounded-md">+
                                        Minggu</button>
                                </div>
                                <div id="treasurer-actions" class="hidden flex space-x-2"></div>
                            </div>
                        </div>
                        <div class="glass-card p-4 rounded-xl mb-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                                <div><label for="kas-filter-week"
                                        class="block text-sm font-medium text-gray-400 mb-1">Minggu ke-</label><select
                                        id="kas-filter-week"
                                        class="w-full py-2 px-3 bg-gray-900 border border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-400 text-white"></select>
                                </div>
                                <div><label for="kas-filter-class"
                                        class="block text-sm font-medium text-gray-400 mb-1">Kelas</label><select
                                        id="kas-filter-class"
                                        class="w-full py-2 px-3 bg-gray-900 border border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-400 text-white"></select>
                                </div>
                                <div><label for="kas-filter-status"
                                        class="block text-sm font-medium text-gray-400 mb-1">Status</label><select
                                        id="kas-filter-status"
                                        class="w-full py-2 px-3 bg-gray-900 border border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-400 text-white">
                                        <option value="all">Semua</option>
                                        <option value="Lunas">Lunas</option>
                                        <option value="Belum Lunas">Belum Lunas</option>
                                    </select></div>
                                <div><label for="kas-filter-name" class="block text-sm font-medium text-gray-400 mb-1">Cari Nama / NIM</label>
                                    <div class="search-wrapper">
                                        <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/></svg>
                                        <input type="text" id="kas-filter-name" placeholder="Nama atau NIM..." class="search-input w-full py-2 px-3 bg-gray-900 border border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-400 text-white">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="glass-card p-6 rounded-xl">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left">
                                    <thead>
                                        <tr class="border-b border-gray-800">
                                            <th
                                                class="p-2 md:p-4 text-sm font-semibold text-gray-400 hidden md:table-cell">
                                                NIM</th>
                                            <th class="p-2 md:p-4 text-sm font-semibold text-gray-400">Nama</th>
                                            <th class="p-2 md:p-4 text-sm font-semibold text-gray-400">Kelas</th>
                                            <th class="p-2 md:p-4 text-sm font-semibold text-gray-400">Total Setoran
                                            </th>
                                            <th class="p-2 md:p-4 text-sm font-semibold text-gray-400">Status</th>
                                            <th class="p-2 md:p-4 text-sm font-semibold text-gray-400 text-center">Aksi
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody id="kas-angkatan-table"></tbody>
                                </table>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-8">
                            <div id="rekap-pemasukan-container" class="glass-card p-6 rounded-xl"></div>
                            <div id="tren-kas-container" class="glass-card p-6 rounded-xl"></div>
                        </div>
                    </div>
                    <div id="view-pengeluaran" class="view hidden"></div>
                    <div id="view-arsip" class="view hidden"></div>
                    <div id="view-admin" class="view hidden"></div>
                </div>
            </div>
        </div>
    </div>

    <div id="kas-input-modal"
        class="hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-30 p-4"></div>
    <div id="kas-edit-modal"
        class="hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-30 p-4"></div>
    <div id="kas-expense-modal"
        class="hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-30 p-4"></div>
    <div id="add-student-modal"
        class="hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-30 p-4"></div>
    <div id="manage-roles-modal"
        class="hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-30 p-4"></div>
    <div id="transaction-history-modal"
        class="hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-30 p-4"></div>
    <div id="alert-modal" class="hidden fixed inset-0 bg-black bg-opacity-70 flex items-center justify-center z-40 p-4">
    </div>
    <div id="nim-registration-modal"
        class="hidden fixed inset-0 bg-black bg-opacity-80 flex items-center justify-center z-50 p-4">
        <div class="glass-card p-8 rounded-2xl shadow-2xl shadow-black/30 w-full max-w-sm">
            <h3 class="text-2xl font-bold text-white mb-2">Selamat Datang!</h3>
            <p class="text-gray-400 mb-6">Masukkan NIM Anda untuk menyelesaikan pendaftaran.</p>
            <form id="nim-registration-form">
                <div>
                    <label for="nim-input" class="block text-sm font-medium text-gray-400 mb-1">NIM</label>
                    <input type="text" id="nim-input" name="nim"
                        class="w-full py-3 px-4 bg-gray-900 border border-gray-700 rounded-lg text-white" required
                        placeholder="Contoh: 25090620001">
                </div>
                <div class="flex items-center justify-end gap-4 mt-8">
                    <button type="button" id="logout-from-reg-btn"
                        class="text-gray-400 hover:text-white font-semibold">Keluar</button>
                    <button type="submit" class="px-6 py-3 btn-primary rounded-lg font-bold">Daftar</button>
                </div>
            </form>
        </div>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
        import { getAuth, onAuthStateChanged, signInWithPopup, GoogleAuthProvider, signOut } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
        import { getFirestore, collection, addDoc, doc, setDoc, getDoc, getDocs, deleteDoc, query, onSnapshot, serverTimestamp, orderBy, writeBatch, limit, updateDoc, where, Timestamp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

        const firebaseConfig = {
            apiKey: "AIzaSyA6OoKEDECUhf9kzTXPDVybXQnx3Oor9xM",
            authDomain: "elka-financial-app.firebaseapp.com",
            projectId: "elka-financial-app",
            storageBucket: "elka-financial-app.appspot.com",
            messagingSenderId: "754443991037",
            appId: "1:754443991037:web:62f9b95b4a39370577cb94"
        };
        const WEEKLY_TARGET = 5000;
        const SEMESTER_2_START_WEEK = 17; // Ubah angka ini sesuai minggu mulai semester 2
        const getWeeklyTarget = (week) => week >= SEMESTER_2_START_WEEK ? 2000 : 5000;
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        const provider = new GoogleAuthProvider();

        let currentUser = null, userData = null;
        let unsubscribers = [];
        let isInitialLoad = true;

        const state = {
            allStudents: [],
            kasTransactions: [],
            kasExpenses: [],
            roles: {},
            announcement: null,
            currentWeek: 1,
            manualMaxWeek: 1,
            paymentStatusPage: 0,
            trenKasPage: 0
        };

        const formatCurrency = (amount) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(amount);
        const formatDateTime = (timestamp) => timestamp ? new Date(timestamp.seconds * 1000).toLocaleString('id-ID', { dateStyle: 'long', timeStyle: 'short' }) : '-';

        // Anti-XSS: escape user-provided strings before injecting into innerHTML
        const sanitize = (str) => String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');

        // Lightweight toast — replaces modal for success messages to reduce interruption
        const showToast = (type, message, duration = 3500) => {
            const container = document.getElementById('toast-container');
            if (!container) return;
            const icon = type === 'success'
                ? `<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
                : `<svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`;
            const el = document.createElement('div');
            el.className = `toast ${type}`;
            el.innerHTML = `${icon}<span>${sanitize(message)}</span>`;
            container.appendChild(el);
            setTimeout(() => {
                el.classList.add('fade-out');
                el.addEventListener('animationend', () => el.remove(), { once: true });
            }, duration);
        };

        // Build O(1) lookup map: transactionIndex[nim][week] = totalAmount
        // Call this whenever state.kasTransactions changes instead of filtering in every render
        let transactionIndex = {};
        const buildTransactionIndex = () => {
            transactionIndex = {};
            state.kasTransactions.forEach(t => {
                if (!transactionIndex[t.nim]) transactionIndex[t.nim] = {};
                transactionIndex[t.nim][t.week] = (transactionIndex[t.nim][t.week] || 0) + t.amount;
            });
        };

        // Helper: get total paid by a student in a specific week using the index
        const getTotalPaid = (nim, week) => (transactionIndex[nim]?.[week] || 0);

        const showAlert = (type, title, message) => {
            const modal = document.getElementById('alert-modal');
            const isSuccess = type === 'success';
            const iconColor = isSuccess ? 'text-yellow-300' : 'text-yellow-600';
            const bgColor = isSuccess ? 'bg-yellow-400/10' : 'bg-yellow-600/10';

            modal.innerHTML = `
                <div class="glass-card p-8 rounded-2xl shadow-2xl shadow-black/30 w-full max-w-sm text-center">
                    <div class="mx-auto mb-4 w-16 h-16 rounded-full flex items-center justify-center ${bgColor}">
                        ${isSuccess ? `<svg class="w-10 h-10 ${iconColor}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>` : `<svg class="w-10 h-10 ${iconColor}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`}
                    </div>
                    <h3 class="text-2xl font-bold mb-2 text-white">${title}</h3>
                    <p class="text-gray-300 mb-8">${message}</p>
                    <button id="alert-ok-btn" class="w-full px-6 py-3 btn-primary rounded-lg font-bold">OK</button>
                </div>`;
            modal.classList.remove('hidden');
            modal.querySelector('#alert-ok-btn').addEventListener('click', () => modal.classList.add('hidden'));
        };

        const showConfirm = (title, message) => {
            return new Promise((resolve) => {
                const modal = document.getElementById('alert-modal');
                modal.innerHTML = `
                <div class="glass-card p-8 rounded-2xl shadow-2xl shadow-black/30 w-full max-w-sm text-center">
                    <div class="mx-auto mb-4 w-16 h-16 rounded-full flex items-center justify-center bg-yellow-600/10">
                        <svg class="w-10 h-10 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.546-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-2 text-white">${title}</h3>
                    <p class="text-gray-300 mb-8">${message}</p>
                    <div class="flex justify-center gap-4">
                        <button id="confirm-cancel-btn" class="w-full px-6 py-3 btn-secondary rounded-lg font-bold">Batal</button>
                        <button id="confirm-ok-btn" class="w-full px-6 py-3 btn-primary rounded-lg font-bold">Yakin</button>
                    </div>
                </div>`;
                modal.classList.remove('hidden');

                const close = () => modal.classList.add('hidden');

                modal.querySelector('#confirm-ok-btn').onclick = () => {
                    close();
                    resolve(true);
                };
                modal.querySelector('#confirm-cancel-btn').onclick = () => {
                    close();
                    resolve(false);
                };
            });
        };

        const getRoleName = (role) => ({
            mahasiswa: 'Mahasiswa', bendahara_praktik: 'Bendahara Praktik',
            bendahara_teori: 'Bendahara Teori', bendahara_angkatan: 'Ketua Kelas',
        }[role] || 'Tidak Diketahui');

        const hasPermissionToEdit = (studentToEdit) => {
            if (!userData || !studentToEdit) return false;
            switch (userData.role) {
                case 'bendahara_angkatan': return true;
                case 'bendahara_teori': return userData.theoryClass === studentToEdit.theoryClass;
                case 'bendahara_praktik': return userData.practiceClass === studentToEdit.practiceClass;
                default: return false;
            }
        };

        const findStudentByNim = (nim) => state.allStudents.find(s => s.nim === nim);


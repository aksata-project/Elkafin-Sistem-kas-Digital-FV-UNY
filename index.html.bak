                const studentRef = doc(db, "students", s.nim);
                batch.set(studentRef, {
                    name: s.name,
                    nim: s.nim,
                    practiceClass: s.class,
                    theoryClass: s.class.charAt(0),
                    email: s.email || null
                });
            });

            for (const nim in initialRoles) {
                const roleRef = doc(db, "roles", nim);
                batch.set(roleRef, { role: initialRoles[nim] });
            }

            batch.set(doc(db, "internal_config", "weeks"), { manualMaxWeek: 1 });
            batch.set(setupDocRef, { isComplete: true, setupAt: serverTimestamp() });

            await batch.commit();
